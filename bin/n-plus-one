#!/usr/bin/env php
<?php

declare(strict_types=1);

use NPlusOne\PHPUnit\Console\AnalyzeCommand;

$autoloaders = [
    // Installed as a dependency: vendor/djzt/phpunit-n-plus-one/bin/n-plus-one
    __DIR__ . '/../../../autoload.php',
    // Running from a checkout of the package itself
    __DIR__ . '/../vendor/autoload.php',
];

$loaded = false;

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;
        $loaded = true;

        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, 'Could not find the Composer autoloader; run "composer install" first.' . PHP_EOL);

    exit(2);
}

exit((new AnalyzeCommand())->run(array_slice($argv, 1)));
