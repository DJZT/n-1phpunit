<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by tests/Integration/EndToEndTest.php: a miniature "host project" that
     registers the extension exactly the way a Laravel application would. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="../../vendor/autoload.php"
         cacheDirectory="../../.phpunit.cache/fixtures"
         colors="false">
    <testsuites>
        <testsuite name="feature">
            <directory>Feature</directory>
        </testsuite>
    </testsuites>
    <extensions>
        <bootstrap class="NPlusOne\PHPUnit\NPlusOneExtension">
            <parameter name="threshold" value="3"/>
            <parameter name="limit" value="10"/>
            <parameter name="colors" value="false"/>
        </bootstrap>
    </extensions>
</phpunit>
